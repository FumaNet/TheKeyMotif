# --- editor and OS junk ---
*.bak
*.pyc
__pycache__/
.DS_Store
desktop.ini
Thumbs.db
.ipynb_checkpoints/

# --- environments ---
.venv/
venv/
env/

# NOTE ON CASING: every path below is written against the CURRENT tree
# (Data/, Motifs_KO/, Results/). The Step-3 restructure renames these to
# lowercase (data/, motifs/, results/); as the FINAL action of that step,
# replace every line below with its new-layout path and drop the old one.
# This mount happens to resolve paths case-insensitively, which is why a
# stale-cased line doesn't obviously fail here -- it would on a
# case-sensitive clone (Linux, most CI), so don't leave both variants
# lying around past the restructure.

# --- derived artifacts: regenerable from the scripts in analysis/ ---
Data/esm2_embeddings_rbp.csv
Data/esm2_embeddings_loci.csv
Data/esm2_embeddings_loci_per_protein.csv
Data/cache/
Results/klebphacol/stage3_rbp_embeddings.npy
Results/*_checkpoint*.pkl

# --- third-party sequence data (see data/README.md for sources) ---
Data/genomes/
Data/*.zip

# --- third-party model and supplementary files ---
Data/tropiseq/TropiSEQ_model/
Data/tropiseq/TropiSEQ_model.zip
Data/klebphacol/*.docx
Data/klebphacol/*.xlsb

# --- structure models from the withdrawn analysis ---
Motifs_KO/**/*.cif

# --- MEME scratch output ---
Motifs_foldwise/**/logo*.eps

# --- ad hoc validation-prediction dumps from the withdrawn motif analysis ---
Motifs_KO/Analysis/validation_predictions_*.csv

# Keep the motif occurrence files that Fig 5 depends on:
!Motifs_KO/**/*_fasta.txt
!Motifs_KO/**/*.meme
