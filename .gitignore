motifs/foldwise/**/meme.xml
motifs/foldwise/**/meme.html
motifs/foldwise/**/meme.txt

# --- ad hoc validation-prediction dumps from the withdrawn motif analysis ---
motifs/occurrences/Analysis/validation_predictions_*.csv

# Keep the motif occurrence files that Fig 5 depends on:
!motifs/occurrences/**/*_fasta.txt
!motifs/occurrences/**/*.meme

